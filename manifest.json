{
  "manifest_version": 3,
  "name": "PhishArmor",
  "version": "2.1.0",
  "description": "AI-powered phishing detection for your emails.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "contextMenus",
    "identity"
  ],
  "host_permissions": [
    "*://mail.google.com/*",
    "https://gmail.googleapis.com/*",
    "https://phisharmor-backend-bd392.ondigitalocean.app/*",
    "https://indcrrlvpotinxdhrthg.supabase.co/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://phisharmor-backend-bd392.ondigitalocean.app https://indcrrlvpotinxdhrthg.supabase.co https://gmail.googleapis.com"
  },
  "action": {
    "default_popup": "popup/popup-v2.html",
    "default_icon": {
      "16": "icons/16x16.png",
      "32": "icons/32x32.png",
      "48": "icons/48x48.png",
      "128": "icons/128x128.png"
    }
  },
  "background": {
    "service_worker": "background/background-v2.js"
  },
  "options_page": "options/options-v2.html",
  "content_scripts": [
    {
      "matches": ["*://mail.google.com/*"],
      "js": ["content_scripts/content.js"],
      "css": ["content_scripts/content.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/shield-green.png",
        "icons/shield-yellow.png",
        "icons/shield-red.png",
        "icons/shield-grey.png",
        "icons/shield-blue.png",
        "icons/logo-50x50.png",
        "icons/checkmark-green.png",
        "icons/cross-red.png",
        "icons/icon-placeholder.png",
        "icons/loading.gif",
        "assets/logo1.png"
      ],
      "matches": ["*://mail.google.com/*"]
    }
  ],
  "icons": {
    "16": "icons/16x16.png",
    "32": "icons/32x32.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "externally_connectable": {
    "matches": [
      "https://app.phisharmor.ai/*",
      "https://*.phisharmor.ai/*",
      "https://phisharmor.com/*",
      "https://*.phisharmor.com/*"
    ]
  }
}
